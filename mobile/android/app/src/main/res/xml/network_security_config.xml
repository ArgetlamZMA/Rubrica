<?xml version="1.0" encoding="utf-8"?>
<!-- Rúbrica solo hace estas conexiones de red: marca de tiempo (RFC 3161), OCSP, listas CRL y certificados de emisores
     (validación a largo plazo de firmas), y la nube que el usuario conecta. Las autoridades publican las primeras casi
     siempre por http y en dominios que no se conocen de antemano (cualquier TSA o autoridad certificadora del mundo).
     Todas esas respuestas están firmadas y Rúbrica las verifica, así que http no compromete su integridad.
     La interfaz es local: el WebView no carga páginas de internet. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
