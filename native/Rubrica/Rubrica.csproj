<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Rubrica</AssemblyName>
    <RootNamespace>Rubrica</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.0</Version>
    <!-- versión de producto idéntica en cada compilación (requisito de SignPath): sin el hash del commit -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Rúbrica</Product>
    <Company>ZMA Inversiones</Company>
    <Copyright>© 2026 Christian Díaz Fajardo — Licencia MIT</Copyright>
    <Description>Editor PDF libre para Windows</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
  </ItemGroup>

  <!-- Interfaz web compilada (web/dist). Ejecute "npm ci && npm run build" en /web antes de compilar. -->
  <ItemGroup>
    <Content Include="..\..\web\dist\**\*" Exclude="..\..\web\dist\__t\**" LinkBase="web" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rubrica.Tests" />
  </ItemGroup>

</Project>
